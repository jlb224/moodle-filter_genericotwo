{{!
    @template filter_genericotwo/pagewidth_toggle

    The pagewidth toggle - limited width or fullwidth

    Example context (json):
    {
    }
}}

<div class="form-check form-switch mb-3">
    <input type="checkbox" class="form-check-input" role="switch"
        id="filter-genericotwo-pagewidth-{{uniqid}}"
        data-action="filter_genericotwo/pagewidth-toggle"
        {{#fullwidth}}checked{{/fullwidth}}>
    <label class="form-check-label" for="filter-genericotwo-pagewidth-{{uniqid}}">
        {{#str}} fullwidth, filter_genericotwo {{/str}}
    </label>
</div>